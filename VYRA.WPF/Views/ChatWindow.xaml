<Window x:Class="VYRA.WPF.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VYRA"
        Width="1000"
        Height="700"
        MinWidth="760"
        MinHeight="480"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource VyraBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="VyraTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource VyraInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource VyraTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource VyraTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="BorderBrush" Value="#2F6F2F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,4">
                <Border Padding="10"
                        MaxWidth="620"
                        Background="{Binding BubbleBrush}"
                        HorizontalAlignment="{Binding BubbleAlignment}"
                        CornerRadius="12">
                    <StackPanel>
                      <Image Source="{Binding Image}"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"
                            Width="400"
                            Height="250"
                            Stretch="Uniform"
                            Margin="0,0,0,8"/>

                      <TextBlock Text="{Binding Text}"
                                Visibility="{Binding HasText, Converter={StaticResource BoolToVisibility}}"
                                Foreground="LightGreen"
                                FontFamily="Consolas"
                                FontSize="15"
                                TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition x:Name="ScreenshotColumn" Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{StaticResource VyraPanelBrush}"
                BorderBrush="#183018"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,10">
            <ScrollViewer x:Name="HistoryScrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource MessageTemplate}"/>
            </ScrollViewer>
        </Border>

        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 Grid.Column="0"
                 Margin="0,0,10,8"
                 Style="{StaticResource VyraTextBoxStyle}"
                 PreviewKeyDown="InputBox_PreviewKeyDown"/>

        <Border x:Name="ScreenshotPreviewHost"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,8"
                Background="{StaticResource VyraPanelBrush}"
                BorderBrush="#2F6F2F"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <Image x:Name="ScreenshotPreview" Stretch="Uniform"/>
        </Border>

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   Text="Enter send    Shift+Enter new line    Esc close"
                   Foreground="{StaticResource VyraMutedTextBrush}"
                   VerticalAlignment="Center"/>

        <CheckBox x:Name="SendScreenshotCheckBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Content="Send screenshot (Alt+S)"
                  Foreground="{StaticResource VyraTextBrush}"
                  IsChecked="True"
                  VerticalAlignment="Center"
                  Checked="SendScreenshotCheckBox_Changed"
                  Unchecked="SendScreenshotCheckBox_Changed"/>
    </Grid>
</Window>
